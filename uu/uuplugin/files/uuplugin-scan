#!/bin/sh
# uu-scan —— 发现局域网里的游戏机并纳入 UU 加速
#
# 识别策略（从弱到强）：
#   1. 被动清单：合并 DHCP 租约与 ARP/邻居表，按任天堂 OUI 与主机名特征标记候选
#   2. 主动扫描：ping 扫全网段把沉默设备逼出 ARP 表，再走 1
#   3. 差分识别：与厂商无关——记基线，让目标设备重连网络，新出现的就是它
#      （对 OUI 未收录的新硬件、随机化 MAC 一样有效）
#
# 自动模式（auto，由 init 在 start/reload 时调用）：
#   uuplugin.main.autodetect=1  发现候选设备时写日志提示（默认开）
#   uuplugin.main.autoadd=1     命中任天堂 OUI 的设备直接加入加速（默认关：
#                               加入意味着该设备脱离 PassWall，需用户授权）
#
# 判定用的特征表都是数据文件，可直接编辑，不用改脚本（都是 conffiles，
# 升级包不会覆盖你的改动）：
#   /usr/share/uuplugin/nintendo-oui       任天堂 MAC 前缀
#   /usr/share/uuplugin/hostname-hints     主机名正则（每行一条）
# 主机名表里写出"匹配一切"的规则（空分支 a||b、. 、.*、^）会被拒收：整表
# 停用并告警——autoadd=1 时它意味着全网设备一起脱离 PassWall。
#
# 环境变量（都有安全默认值，一般不用管）：
#   UU_SWEEP_MAX   sweep 一次最多 ping 多少个地址，默认 510（即一个 /23）
#   UU_LAN_IFACE   lan 接口的逻辑名（优先于 uuplugin.main.lan_iface，默认 lan）
#   UU_LEASES      只读这一个租约文件，跳过整张候选表（调试/测试用）
#
# 用法（经 service uuplugin <动作> 暴露；本脚本是内部实现，auto 由 init 调用）：
#   service uuplugin scan              被动清单
#   service uuplugin sweep             主动扫描（ping 扫整个 lan 网段后出清单）
#   service uuplugin watch [秒]        差分识别，默认 120 秒：期间让 NS2 重连 Wi-Fi
#   service uuplugin add <mac> [名字]  手动加入（人工填写入口，始终保留）

# 不开 set -u：/lib/functions.sh 非 nounset-clean（裸引用 IPKG_INSTROOT 等），
# source 即炸。防御靠显式默认值与引号。

. /lib/functions.sh

OUI_FILE="${UU_OUI_FILE:-/usr/share/uuplugin/nintendo-oui}"
HINT_FILE="${UU_HINT_FILE:-/usr/share/uuplugin/hostname-hints}"
# 显式设了 UU_LEASES 就只读它（候选表机制整个跳过）；不设则由 resolve_leases
# 按候选表找并填进 LEASE_FILES，见那边的注释
LEASES="${UU_LEASES:-}"
LEASE_FILES=""
INIT="${UU_INIT:-/etc/init.d/uuplugin}"
RENDER="${UU_RENDER:-/usr/libexec/uuplugin/render}"
LAN_DEV="${UU_LAN_DEV:-}"
LAN_SUBNET="${UU_LAN_SUBNET:-}"

# lan 接口的逻辑名（netifd/uci 里的接口名，不是 br-lan 这种设备名）。
# 优先级：UU_LAN_IFACE > uuplugin.main.lan_iface > lan。
# 用 uci -q get 直读而不 config_load dhcp/uuplugin：清空 CONFIG_SECTIONS 的
# 是 uci 包 /lib/config/uci.sh 里的 uci_load（CONFIG_APPEND 为空时置空重建）。
# 本脚本各处 config_load uuplugin 读完的值都落进了普通变量，此刻插一次别的
# config_load 当场不会坏，但会埋下"谁挪了调用次序就无声坏掉"的顺序依赖——
# 直连 uci 是为了根本不建立这个依赖。
# 校验字符集对齐 libuci 的 uci_validate_name（[A-Za-z0-9_]+）：空/未设是
# 常态，静默回落默认；非空但含非法字符（十有八九是把 br-lan 这种设备名当成
# 接口名填了进来）回落默认并 warn——静默吞掉会让清单/扫描悄悄跑错接口。
LAN_IFACE="${UU_LAN_IFACE:-$(uci -q get uuplugin.main.lan_iface)}"
case "$LAN_IFACE" in
'') LAN_IFACE=lan ;;
*[!A-Za-z0-9_]*)
	logger -t uuplugin -p daemon.warn \
		"uuplugin.main.lan_iface='${LAN_IFACE}' 含非法字符（须匹配 [A-Za-z0-9_]+），回落到 lan"
	LAN_IFACE=lan
	;;
esac

# 主动扫描的地址数上限。取 /23（510 个）有两条理由：
#   * 时间：按 32 并发、每个 -W 1 算最坏约十几秒，再大就不是"扫一下"而是挂机
#   * 邻居表：扫描会给每个不存在的地址留一条 FAILED 表项，而内核默认
#     gc_thresh3=1024（gc_thresh2=512）。贴着 1024 扫等于自己把 ARP 表顶穿，
#     内核开始丢新邻居的包——为了找一台游戏机把全网抖一下，不划算
# 超限时明说扫不动，绝不偷偷只扫前 254 个——静默的部分结果比没有结果更误导人。
# 真有 /22 及以上的大网段，请自己抬 UU_SWEEP_MAX，让它成为一次有意识的选择。
SWEEP_MAX_HOSTS="${UU_SWEEP_MAX:-510}"

MAC_PAT='[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]:[0-9a-fA-F][0-9a-fA-F]'

# 不写死行号：头部注释块的长度会随文档增删而变，写死的 '2,23p' 迟早对不上，
# 而且没人会注意到——改用"从第 2 行起，打到第一行非注释为止"
usage() {
	awk 'NR==1{next} !/^#/{exit} {sub(/^# ?/, ""); print}' "$0"
}

resolve_lan() {
	[ -n "$LAN_DEV" ] && return 0
	if [ -f /lib/functions/network.sh ]; then
		. /lib/functions/network.sh
		network_get_device LAN_DEV "$LAN_IFACE" 2>/dev/null || true
	fi
	LAN_DEV="${LAN_DEV:-br-${LAN_IFACE}}"
}

# 注意 network_get_subnet 返回的是"接口地址/前缀长度"（如 192.168.7.1/24），
# 不是网络地址——用它枚举网段前必须自己掩一次
resolve_subnet() {
	[ -n "$LAN_SUBNET" ] && return 0
	if [ -f /lib/functions/network.sh ]; then
		. /lib/functions/network.sh
		network_get_subnet LAN_SUBNET "$LAN_IFACE" 2>/dev/null || true
	fi
}

# 点分十进制四段、每段 0-255。前导零一律拒：$(( 09 )) 会被当八进制解析而报错，
# 而报错在 $( ) 里只剩一个空串，下游会拿着空值继续走还打印"共  个地址"。
valid_ipv4() { # $1=地址
	local o1 o2 o3 o4 extra o
	IFS=. read -r o1 o2 o3 o4 extra <<-EOF
		$1
	EOF
	[ -z "$extra" ] || return 1
	for o in "$o1" "$o2" "$o3" "$o4"; do
		# IFS 是 "."，所以空格不会被 read 吃掉，" 192" 在这里就被挡下
		case "$o" in
		0 | [1-9] | [1-9][0-9] | [1-9][0-9][0-9]) ;;
		*) return 1 ;;
		esac
		[ "$o" -le 255 ] || return 1
	done
	return 0
}

# 逐字节掩码，不把 IP 拼成整数：mipsel/arm 上 shell 算术是 32 位有符号的，
# 192<<24 直接溢出成负数（真机上会静默扫错网段）
ip_mask() { # $1=ip $2=前缀长度 -> 网络地址
	local o1 o2 o3 o4 v idx=0 bits step out=""
	IFS=. read -r o1 o2 o3 o4 <<-EOF
		$1
	EOF
	for v in "$o1" "$o2" "$o3" "$o4"; do
		bits=$(($2 - idx * 8))
		if [ "$bits" -le 0 ]; then
			v=0
		elif [ "$bits" -lt 8 ]; then
			step=1
			while [ "$bits" -lt 8 ]; do
				step=$((step * 2))
				bits=$((bits + 1))
			done
			v=$((v - v % step))
		fi
		out="${out}${out:+.}${v}"
		idx=$((idx + 1))
	done
	printf '%s' "$out"
}

# 可 ping 的地址数。/31、/32 没有网络/广播地址的概念，其余去掉这两个。
# 只算到 /2：2^31 在 32 位有符号里就翻成负数了，/1、/0 一律判为"算不出"，
# 由调用方去说"大到没法逐个枚举"。绝不编一个数字冒充真实规模报给人看——
# 那会让"超过上限 N"读起来像"把 N 抬一点就能扫"，而实际差着六个数量级。
host_count() { # $1=前缀长度 -> 地址数；算不出时无输出且返回 1
	local h n=1
	h=$((32 - $1))
	[ "$h" -gt 30 ] && return 1
	while [ "$h" -gt 0 ]; do
		n=$((n * 2))
		h=$((h - 1))
	done
	[ "$n" -gt 2 ] && n=$((n - 2))
	printf '%s' "$n"
}

# ---------------------------------------------------------------------------
# 采集与判定
# ---------------------------------------------------------------------------

# 租约文件候选表 -> LEASE_FILES（空白分隔）。UU_LEASES 显式设置时不走这里。
#
# 候选 = UCI 里每个 dnsmasq 类型 section 的 leasefile ∪ 内置三条常规路径，
# 去重后存在的全读（多个 dnsmasq 实例就是多份 leasefile，都得读；跨文件的
# 重复 MAC 由 gather 末端的 !seen[$1]++ 去重，先读到的赢）。
#
# UCI 读取用 uci -q show 而不 config_load dhcp，理由同顶部 LAN_IFACE 那段：
# 不建立 uci_load 清空 CONFIG_SECTIONS 的调用次序依赖。dhcp 配置整个不存在
# 时 show 输出为空，安静回落到内置三条。
#
# 只收 dnsmasq 的 leasefile，排除标准是落盘格式，不是路径长相：
#   * lease_rows 的 awk 按 dnsmasq 五字段行（<到期秒> <mac> <ip> <主机名>
#     <clientid>）取 $2/$3/$4；
#   * odhcpd（dhcp.odhcpd.leasefile）与 ISC dhcpd（多行花括号语法）的文件
#     喂进去不报错、只吐垃圾行，而 autoadd=1 时垃圾"MAC"会被 render 写进
#     PassWall ACL 的 sources——全网设备一起脱离代理；
#   * 真二进制的 strings 里其实有四条租约路径（第四条 /etc/config/
#     dhcpd.leases 在它内部配了独立的 ISC 解析器），我们没有那个解析器，
#     只收格式兼容的三条。
resolve_leases() {
	local f all
	[ -n "$LEASES" ] && return 0
	LEASE_FILES=""
	# @dnsmasq[0] 这种匿名 section 名里的 [] 是合法通配符，遍历期间关掉
	# glob（理由同 uuplugin.defaults 的 zone_exists；set -f 会被 $( ) 继承）
	set -f
	all=$(
		{
			for f in $(uci -q show dhcp 2>/dev/null |
				sed -n 's/^dhcp\.\([^=]*\)=dnsmasq$/\1/p'); do
				uci -q get "dhcp.${f}.leasefile"
			done
			printf '%s\n' /tmp/dhcp.leases /var/lib/misc/dnsmasq.leases \
				/tmp/var/lib/misc/dnsmasq.leases
		} | awk '!seen[$0]++'
	)
	set +f
	# 逐行读而不是 for in $(...)：含空格的路径会先被字段拆分再校验，拆出来
	# 的碎片（如 "/tmp/bad"）反而条条合规，校验就被绕过去了
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		# 路径校验：必须以 / 开头、只含 [A-Za-z0-9_./-]。合规字符集里没有
		# 空白和通配符，之后 gather 按空白拆 $LEASE_FILES 才是安全的。
		# 违规跳过该条并 warn，不整体退出——一条写坏的 leasefile 不该把
		# 被动清单整个打死。
		case "$f" in
		/*) ;;
		*)
			printf '警告：忽略相对路径的租约文件候选 %s（请检查 uci dhcp 的 leasefile）\n' "$f" >&2
			continue
			;;
		esac
		case "$f" in
		*[!A-Za-z0-9_./-]*)
			printf '警告：忽略含非常规字符的租约文件候选 %s（请检查 uci dhcp 的 leasefile）\n' "$f" >&2
			continue
			;;
		esac
		LEASE_FILES="${LEASE_FILES}${LEASE_FILES:+ }${f}"
	done <<-EOF
		$all
	EOF
}

# dnsmasq 租约行 -> mac|ip|hostname|lease。格式守门：$1 必须是纯数字到期秒
# （0=永久租约，也合法），$2 必须形如 MAC；对不上的行静默丢弃——这正是
# odhcpd/ISC 格式的文件误入候选时垃圾不外流的最后一道闸
lease_rows() { # $1=租约文件
	awk '$1 ~ /^[0-9]+$/ &&
		$2 ~ /^[0-9a-fA-F][0-9a-fA-F](:[0-9a-fA-F][0-9a-fA-F]){5}$/ {
			print tolower($2) "|" $3 "|" $4 "|lease"
		}' "$1"
}

# 输出：mac|ip|hostname|来源，mac 小写，按 mac 去重（租约优先，含主机名；
# 多份租约文件时先读到的赢）
gather() {
	local f
	{
		if [ -n "$LEASES" ]; then
			# UU_LEASES 显式指定：只读它，且不做候选表那套拆分与校验
			[ -f "$LEASES" ] && lease_rows "$LEASES"
		else
			for f in $LEASE_FILES; do
				[ -f "$f" ] && lease_rows "$f"
			done
		fi
		ip -4 neigh show dev "$LAN_DEV" 2>/dev/null |
			awk '/lladdr/ {print tolower($3) "|" $1 "||neigh"}'
	} | awk -F'|' '!seen[$1]++'
}

is_nintendo() { # $1=mac(小写)
	[ -f "$OUI_FILE" ] || return 1
	grep -q "^$(printf '%s' "$1" | cut -c1-8)" "$OUI_FILE"
}

# 主机名特征表：每行一条 ERE，拼成一条交替式（| 优先级最低，每行天然是
# 一个顶层分支，行内自己的 | 只要包在括号里就不受影响）。
# 数据文件缺失（没装/被删）→ 用内置兜底；文件在但被清空 → 视为用户明确
# 表示"不按主机名判定"，直接不匹配（空正则会匹配一切，绝不能退化成它）。
HINT_BUILTIN='switch|nintendo|(^|[^a-z0-9])nx([^a-z0-9]|$)'
HINT_RE=""
HINT_LOADED=""

# 通配探针的两串哨兵（用法见 load_hints 的第三道闸）。选串的三条硬要求：
#   * 一串纯字母、一串纯数字：这样 [a-z]、[0-9] 这种"宽而不通配"的规则
#     各只命中一串，不会被当成通配误杀
#   * 由重复的冷僻字符拼成，不含 nx / ns / ps / xb / sw 这类可能出现在真
#     规则里的二字组——默认表里就有一条 (^|[^a-z0-9])nx([^a-z0-9]|$)。
#     单串撞上真规则还不至于出事（下面是与门，两串齐中才判通配），怕的是
#     同一张表把两串都命中：那会让一张正常的表被自己的防呆闸判死。离真规则
#     留足余量最省事，别去赌"另一串肯定不中"
#   * 两串等长：顺带让 ^.{10}$ 这种按长度写的通配也两串齐中，跑不掉
HINT_PROBE_ALPHA='qqzzjjwwvv'
HINT_PROBE_DIGIT='7700119900'

# 用 -r 而不是 -f：文件在但读不了（权限改坏）要和"没装"走同一条路回落到
# 内置兜底，不能因为 sed 读失败就把 HINT_RE 留空、悄悄关掉主机名判定。
load_hints() {
	[ -n "$HINT_LOADED" ] && return 0
	HINT_LOADED=1
	if [ -r "$HINT_FILE" ]; then
		# ash 没有进程替换，只能 sed 去注释/空白 + tr 拼行。
		# 顺手削掉每行两端的 |：拼接时它们会造出空分支（switch| + nintendo
		# → switch||nintendo），而空分支匹配空串，也就是匹配任何主机名。
		# 用户想表达的显然是 "switch"，按他的意思修，别把整表变成通配。
		HINT_RE=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
			-e 's/^#.*//' -e 's/^|*//' -e 's/|*$//' "$HINT_FILE" |
			grep -v '^$' | tr '\n' '|' | sed 's/|$//')
	else
		HINT_RE="$HINT_BUILTIN"
	fi
	# 行内写成 a||b 的空分支同样等于匹配一切。两端已经削过，这里剩下的
	# || 只可能是行内写出来的。宁可关掉主机名判定，也绝不放行一条会把
	# 全网设备都标成候选的规则（autoadd=1 时那意味着全员脱离 PassWall）。
	case "$HINT_RE" in
	*'||'*)
		printf '警告：%s 里有空的正则分支（||），会匹配任意主机名；已停用主机名判定\n' \
			"$HINT_FILE" >&2
		HINT_RE=""
		;;
	esac
	# 正则本身写坏了（漏括号之类）：grep 返回 >1。不修，但要吵出来——
	# 否则表面上一台都认不出，看不出是规则坏了还是真没有游戏机。
	if [ -n "$HINT_RE" ]; then
		printf 'x\n' | grep -qE -- "$HINT_RE" 2>/dev/null
		if [ "$?" -gt 1 ]; then
			printf '警告：%s 不是合法的正则，已停用主机名判定\n' "$HINT_FILE" >&2
			HINT_RE=""
		fi
	fi
	# 第三类坏规则：语法完全合法、写法上跟正常规则毫无分别、但匹配一切——
	# 一行只写 . 或 .* 或 ^ 或 $ 或 [a-z0-9]。前两道闸看的是"写法"，对这类
	# 一点办法都没有，只能实测：拿两串几乎不可能是真主机名的哨兵去探，正常
	# 规则（switch / nintendo / nx）一串都不该命中。
	# 为什么非要两串都命中才判通配：一串就成了钝锤——只探字母串会把 [a-z]、
	# 只探数字串会把 [0-9] 判成通配。那两条是"过宽"不是"通配"（至少还挑字符
	# 类），够不上整表停用这么重的处置；而 . / .* / ^ / $ / [[:alnum:]] 这类
	# 真通配两串都命中，一条都跑不掉。
	# 必须放在非法正则那道闸之后：正则先得是合法的，探它才有意义。也必须自己
	# 再查一次 -n：前面任何一道闸把 HINT_RE 置空后，空正则匹配一切，会让两串
	# 哨兵双双命中，在"已停用"之后再补一句自相矛盾的警告；用户主动清空特征表
	# （= 关掉主机名判定）时同理，那不是通配规则，不该被骂。
	# grep 的选项必须跟 host_hint 那行逐字一致：判定带 -i，探测不带就漏掉
	# [A-Z0-9] 这种只在忽略大小写下才通配的写法；-- 也不能丢，HINT_RE 以 -
	# 开头时会被 grep 当成选项吞掉，整道闸静默失效。
	if [ -n "$HINT_RE" ] &&
		printf '%s\n' "$HINT_PROBE_ALPHA" | grep -qiE -- "$HINT_RE" 2>/dev/null &&
		printf '%s\n' "$HINT_PROBE_DIGIT" | grep -qiE -- "$HINT_RE" 2>/dev/null; then
		printf '警告：%s 里有匹配一切的通配规则（如 . 或 .* 或 ^），已停用主机名判定\n' \
			"$HINT_FILE" >&2
		HINT_RE=""
	fi
}

host_hint() { # $1=hostname
	load_hints
	[ -n "$HINT_RE" ] || return 1
	# -- 收尾：特征表里以 - 开头的行不能被 grep 当成选项吞掉
	printf '%s' "$1" | grep -qiE -- "$HINT_RE"
}

# 已配置设备的 MAC 集合（换行分隔、小写）
CONF_MACS=""
_collect_mac() {
	local mac
	config_get mac "$1" mac
	[ -n "$mac" ] && CONF_MACS="${CONF_MACS}$(printf '%s' "$mac" | tr 'A-F' 'a-f')
"
}
load_configured() {
	config_load uuplugin
	config_foreach _collect_mac device
}

is_configured() { # $1=mac(小写)
	printf '%s' "$CONF_MACS" | grep -qxF "$1"
}

classify() { # $1=mac $2=host；输出标记列
	local tag=""
	is_nintendo "$1" && tag="任天堂OUI"
	[ -n "$2" ] && [ "$2" != "*" ] && host_hint "$2" && tag="${tag:+${tag}+}主机名特征"
	is_configured "$1" && tag="${tag:+${tag} }[已配置]"
	printf '%s' "${tag:-—}"
}

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------

cmd_list() {
	load_configured
	# 先在父进程里把特征表读进来：下面每台设备的 classify 都跑在 $( ) 子进程
	# 里，各读一遍不但白费进程，load_hints 的警告还会按设备台数重复刷屏
	load_hints
	printf '%-18s %-16s %-20s %s\n' MAC IP 主机名 判定
	gather | while IFS='|' read -r mac ip host _src; do
		printf '%-18s %-16s %-20s %s\n' "$mac" "${ip:--}" "${host:--}" \
			"$(classify "$mac" "${host:-}")"
	done
	printf '\n候选设备加入加速：service uuplugin add <mac> [名字]；识别不出时：service uuplugin watch\n'
}

cmd_sweep() {
	resolve_lan
	resolve_subnet
	local prefix net hosts a b c d i n=0

	# 上限本身必须是个数。非数字会让下面的 [ -gt ] 报错退出 2，而 if 把
	# "报错"读成"条件不成立"，于是上限被静默架空：UU_SWEEP_MAX=2k 会老老实实
	# 把 /20 的 4094 个地址全扫完，UU_SWEEP_MAX=0x400 更糟——只扫 1025 个
	# 就当扫完了整个 /8。宁可什么都不做，也不在上限不明时开扫。
	case "$SWEEP_MAX_HOSTS" in
	'' | *[!0-9]*)
		printf 'UU_SWEEP_MAX="%s" 不是非负整数，拒绝在上限不明的情况下扫描\n' \
			"$SWEEP_MAX_HOSTS" >&2
		return 2
		;;
	esac

	case "$LAN_SUBNET" in
	*.*.*.*/*) ;;
	*)
		printf '取不到 %s 子网，跳过主动扫描，仅列出当前邻居表\n' "$LAN_IFACE"
		cmd_list
		return 0
		;;
	esac

	prefix="${LAN_SUBNET##*/}"
	case "$prefix" in
	0 | [1-9] | [1-9][0-9] | [1-9][0-9][0-9]) ;;
	*)
		printf '%s 子网 %s 的前缀长度读不出来，跳过主动扫描\n' "$LAN_IFACE" "$LAN_SUBNET"
		cmd_list
		return 0
		;;
	esac
	if [ "$prefix" -gt 32 ]; then
		printf '%s 子网 %s 的前缀长度越界，跳过主动扫描\n' "$LAN_IFACE" "$LAN_SUBNET"
		cmd_list
		return 0
	fi
	# 地址一侧同样要验。前缀查得再严，"1.2.3.4.5/26" 也照样能走到下面去
	# ping 62 个字面量叫 "...1"、"...2" 的"主机名"，还打印一行"共 62 个地址"
	# 当成功报出去——这正是本次改动发誓不再犯的那种静默错觉。
	if ! valid_ipv4 "${LAN_SUBNET%%/*}"; then
		printf '%s 子网 %s 的地址部分不是合法 IPv4，跳过主动扫描\n' "$LAN_IFACE" "$LAN_SUBNET"
		cmd_list
		return 0
	fi

	net=$(ip_mask "${LAN_SUBNET%%/*}" "$prefix")
	if ! hosts=$(host_count "$prefix"); then
		printf '%s 是 %s/%s，地址数大到无法逐个枚举，跳过主动扫描。\n' "$LAN_IFACE" "$net" "$prefix"
		printf '这么大的网段请改用差分识别（与网段大小无关）：service uuplugin watch\n'
		cmd_list
		return 0
	fi
	if [ "$hosts" -gt "$SWEEP_MAX_HOSTS" ]; then
		printf '%s 是 %s/%s，逐个 ping 要扫 %s 个地址，超过上限 %s，跳过主动扫描。\n' \
			"$LAN_IFACE" "$net" "$prefix" "$hosts" "$SWEEP_MAX_HOSTS"
		printf '这么大的网段请改用差分识别（与网段大小无关）：service uuplugin watch\n'
		printf '确实要扫满：UU_SWEEP_MAX=%s service uuplugin sweep（注意邻居表压力）\n' "$hosts"
		cmd_list
		return 0
	fi

	IFS=. read -r a b c d <<-EOF
		$net
	EOF
	# /31、/32 没有网络地址，从网络地址本身开始扫；其余跳过网络地址
	if [ "$prefix" -le 30 ]; then
		d=$((d + 1))
	fi

	printf '扫描 %s/%s，共 %s 个地址 ...\n' "$net" "$prefix" "$hosts"
	i=0
	while [ "$i" -lt "$hosts" ]; do
		ping -c 1 -W 1 -q "${a}.${b}.${c}.${d}" >/dev/null 2>&1 &
		n=$((n + 1))
		[ "$n" -ge 32 ] && wait && n=0
		i=$((i + 1))
		# 逐字节进位，理由同 ip_mask
		d=$((d + 1))
		if [ "$d" -gt 255 ]; then
			d=0
			c=$((c + 1))
			if [ "$c" -gt 255 ]; then
				c=0
				b=$((b + 1))
				if [ "$b" -gt 255 ]; then
					b=0
					a=$((a + 1))
				fi
			fi
		fi
	done
	wait
	sleep 1
	cmd_list
}

cmd_watch() {
	resolve_lan
	local timeout="${1:-120}" elapsed=0 base cur mac ip host _src
	base=$(gather | cut -d'|' -f1 | sort)
	printf '基线 %s 台设备。%s 秒内让 NS2 重连网络（休眠唤醒/重开 Wi-Fi 均可）...\n' \
		"$(printf '%s\n' "$base" | grep -c .)" "$timeout"
	while [ "$elapsed" -lt "$timeout" ]; do
		sleep 3
		elapsed=$((elapsed + 3))
		cur=$(gather)
		printf '%s\n' "$cur" | while IFS='|' read -r mac ip host _src; do
			printf '%s\n' "$base" | grep -qxF "$mac" && continue
			printf '\n[%3ss] 新设备：%s  %s  %s\n' "$elapsed" "$mac" "${ip:--}" "${host:--}"
			is_nintendo "$mac" && printf '      ★ 命中任天堂 OUI\n'
			printf '      加入加速：service uuplugin add %s ns2\n' "$mac"
		done
		base=$(printf '%s\n%s' "$base" "$(printf '%s\n' "$cur" | cut -d'|' -f1)" | sort -u)
	done
	printf '\n观察结束。若目标没出现：确认它连的是本路由器、试试 service uuplugin sweep\n'
	return 0
}

cmd_add() {
	local mac="${1:-}" name="${2:-}" sid
	[ -n "$mac" ] || {
		usage
		exit 1
	}
	# shellcheck disable=SC2254
	case "$mac" in
	$MAC_PAT) ;;
	*)
		printf 'MAC 格式无效：%s（期望 aa:bb:cc:dd:ee:ff）\n' "$mac" >&2
		exit 1
		;;
	esac
	mac=$(printf '%s' "$mac" | tr 'A-F' 'a-f')

	load_configured
	if is_configured "$mac"; then
		printf '%s 已在配置中\n' "$mac"
		exit 0
	fi

	sid=$(uci add uuplugin device)
	uci -q set "uuplugin.${sid}.mac=${mac}"
	uci -q set "uuplugin.${sid}.name=${name:-device-$(printf '%s' "$mac" | tr -d : | cut -c7-12)}"
	uci -q set "uuplugin.${sid}.enabled=1"
	uci commit uuplugin
	printf '已加入：%s（%s）\n' "$mac" "$(uci -q get "uuplugin.${sid}.name")"

	if [ -x "$INIT" ]; then
		"$INIT" reload
	else
		"$RENDER" || true
	fi
}

cmd_auto() {
	local autodetect autoadd added=0 mac ip host _src tag
	config_load uuplugin
	config_get_bool autodetect main autodetect 1
	config_get_bool autoadd main autoadd 0
	[ "$autodetect" -eq 1 ] || return 0

	load_configured
	load_hints # 理由同 cmd_list：下面的 while 跑在管道子进程里
	# 注意：此处只依据被动信息，不做主动扫描——auto 会在每次 start/reload
	# 跑，主动扫描留给人工触发的 sweep
	gather | while IFS='|' read -r mac ip host _src; do
		is_configured "$mac" && continue
		tag=""
		is_nintendo "$mac" && tag="任天堂OUI"
		[ -n "${host:-}" ] && [ "$host" != "*" ] && host_hint "$host" && tag="${tag:-主机名特征}"
		[ -n "$tag" ] || continue
		# dnsmasq 无主机名时租约里是 "*"，不能当设备名用
		[ "$host" = "*" ] && host=""
		if [ "$autoadd" -eq 1 ]; then
			sid=$(uci add uuplugin device)
			uci -q set "uuplugin.${sid}.mac=${mac}"
			uci -q set "uuplugin.${sid}.name=${host:-console}"
			uci -q set "uuplugin.${sid}.enabled=1"
			uci commit uuplugin
			logger -t uuplugin "autoadd：已把 ${mac}（${host:--}，${tag}）加入 UU 加速"
			echo added >>"/tmp/.uu-scan-added.$$"
		else
			# auto 随每次 start/reload（含 wan 重连触发）执行，同一候选
			# 每次开机只提示一次，防日志刷屏
			if ! grep -qxF "$mac" /tmp/.uuplugin-notified 2>/dev/null; then
				logger -t uuplugin "发现疑似游戏机：${mac} ${ip:--} ${host:--}（${tag}）。加入加速：service uuplugin add ${mac}"
				echo "$mac" >>/tmp/.uuplugin-notified
			fi
		fi
	done

	# gather 管道在子 shell 里，写标记文件把"是否有新增"带出来
	if [ -f "/tmp/.uu-scan-added.$$" ]; then
		rm -f "/tmp/.uu-scan-added.$$"
		added=1
	fi
	# autoadd 后重渲染 PassWall；直接调 render 而非 init reload，避免从
	# init 调进来时的递归
	[ "$added" -eq 1 ] && "$RENDER"
	return 0
}

# ---------------------------------------------------------------------------

# 所有子命令的 gather 都要读邻居表，LAN 设备名必须在此统一解析——
# 漏掉的话 `ip neigh show dev ""` 会静默失败，清单只剩 DHCP 租约。
# 租约候选表同理：gather 常跑在管道/命令替换的子进程里，候选解析（连同
# 它的 warn）必须在父进程做一次，否则 watch 每 3 秒重复解析、警告刷屏
resolve_lan
resolve_leases

case "${1:-list}" in
list) cmd_list ;;
sweep) cmd_sweep ;;
watch)
	shift
	cmd_watch "${1:-120}"
	;;
add)
	shift
	cmd_add "$@"
	;;
auto) cmd_auto ;;
-h | --help) usage ;;
*)
	usage
	exit 1
	;;
esac
