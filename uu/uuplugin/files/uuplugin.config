config uuplugin 'main'
	option enabled '1'
	# 每次 start/reload 时被动识别局域网里的疑似游戏机并写日志提示
	option autodetect '1'
	# 命中任天堂 OUI 的设备自动加入加速（= 自动脱离 PassWall）。
	# 属于改变流量路径的动作，默认关闭，需明确授权
	option autoadd '0'
	# 死人开关：危险变更（fw4 reload / PassWall 重启 / 拉起二进制）后
	# 若断网且无人确认，此秒数后自动回滚并停用 uuplugin
	option guard_timeout '120'
	# 重启 PassWall 后，等它把 inet passwall 表重建回来的秒数上限；到点还
	# 没回来才判失败并回滚。是上限不是定长等待：表一回来立刻往下走，快设备
	# 照样两三秒收工，调大不会让正常情况变慢。
	# 曾写死 3 秒：MT7621 这类慢设备光把 chnroute/gfwlist 几万条元素灌回
	# nft set 就不止 3 秒，于是每次改设备列表都被误判成重启失败 → 回滚：
	# ACL 白写、PassWall 多挨一次重启、uuplugin 被停用且 disable。
	# 还被误判就往上抬（60 也不过分）。写成非数字会被忽略并回落到默认值。
	option passwall_wait '20'
	# 出网自检探针，ICMP 与 HTTP 任一通过即算正常（防 ICMP 限流误判）。
	# 不设则用内置默认：223.5.5.5 119.29.29.29 / miui generate_204
	# list health_target '223.5.5.5'
	# list health_url 'http://connect.rom.miui.com/generate_204'
	# lan/wan 接口的逻辑名（netifd/uci 的接口名，不是 br-lan 这种设备名）。
	# 只有把 lan/wan 改过名的系统才需要设；示例保持注释掉是有意的——
	# 让代码里的默认值真正生效，不被配置里的显式值架空
	# option lan_iface 'lan'
	# option wan_iface 'wan'

# 需要走 UU 加速的设备，每台一段。这些设备会同时绕过 PassWall。
# 三种加入方式，效果相同：
#   service uuplugin add <mac> [名字]   推荐；先用 scan / watch 识别：
#                                       service uuplugin scan|sweep|watch
#   LuCI/uci 手工编辑本文件后：uci commit uuplugin && /etc/init.d/uuplugin reload
#   autoadd=1 全自动（见上）
#
# config device
#	option name 'ns2'
#	option mac '98:b6:e9:xx:xx:xx'
#	option enabled '1'
